# VEX Events API
VEX_TOKENS=token_1,token_2
# Optional override for season; leave unset to use latest season during incremental runs.
# VEX_SEASON_ID=
VEX_EVENT_START=2025-12-17T00:00:00
# Max requests/sec across all tokens combined. No published VEX rate limit —
# this is a conservative starting guess; tune it from what `-v/--verbose`
# shows (429 frequency) rather than trusting the default as gospel.
# VEX_MAX_REQUESTS_PER_SEC=3.0
# How many events' worth of requests are fetched concurrently per batch
# before results are written to the DB. Smaller = smoother request bursts
# and more frequent progress checkpoints; larger = less overhead.
# VEX_EVENT_BATCH_SIZE=5

# Postgres connection string — e.g. postgresql+psycopg://user:pass@host/dbname
# For the API host, use the pooled (-pooler / PgBouncer) endpoint; keep the
# direct URL for the ingestion pipeline and migrations.
DATABASE_URL=

# Inbound API auth: every endpoint except /api/v1/health requires a bearer token.
# Tokens live in the api_tokens table, not in env — issue and revoke them with:
#   python manage_tokens.py create --label <name>
#   python manage_tokens.py revoke --label <name>   (or --id <n>)

# --- API host only ---
# Run ensure_schema at startup. Leave unset in production (schema is applied once
# per release via fly.toml's release_command); set for local dev / one-off boxes.
# RUN_DB_MIGRATE=1
# In-process GET response cache. 0 disables it (and sends Cache-Control: no-store).
# RESPONSE_CACHE_TTL_SECONDS=120
# RESPONSE_CACHE_MAX_ENTRIES=512
